rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isArtist() {
      return request.auth != null && request.auth.uid == 'a9dFKJad7HUkHnZaNmF1cUTfZ583';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /artists/{artistId}/commissions/{commissionId} {
      allow read, write: if isArtist() && request.auth.uid == artistId;
    }

    match /artists/{artistId}/settings/{settingId} {
      allow read, write: if isArtist() && request.auth.uid == artistId;
    }

    match /artists/{artistId}/notificationDevices/{deviceId} {
      allow read, write: if isArtist() && request.auth.uid == artistId;
    }

    match /artists/{artistId}/trash/{trashId} {
      allow read, write: if isArtist() && request.auth.uid == artistId;
    }

    match /publicStudioSettings/{settingId} {
      allow get: if true;
      allow create, update, delete: if isArtist();
    }

    match /clientProfiles/{userId} {
      allow create, update: if isOwner(userId);
      allow read: if isOwner(userId) || isArtist();
      allow delete: if isArtist();
    }

    match /clientSubmissions/{submissionId} {
      allow create: if request.auth != null
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.ownerUid == 'a9dFKJad7HUkHnZaNmF1cUTfZ583'
        && request.resource.data.state == 'submitted';
      allow read: if isArtist() || (request.auth != null && resource.data.clientUid == request.auth.uid);
      allow update, delete: if isArtist();
    }

    match /clientProgress/{progressId} {
      allow get: if isArtist()
        || (request.auth != null && resource.data.clientUid == request.auth.uid)
        || (resource.data.accessMode == 'code' && resource.data.accessCode == progressId && resource.data.revokedAt == null);
      allow list: if isArtist() || (request.auth != null && resource.data.clientUid == request.auth.uid);
      allow create: if isArtist() || (
        request.auth != null
        && request.resource.data.id == progressId
        && request.resource.data.accessMode == 'code'
        && request.resource.data.accessCode == progressId
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.ownerUid == 'a9dFKJad7HUkHnZaNmF1cUTfZ583'
        && request.resource.data.commissionId == ''
        && request.resource.data.status == 'inquiry'
        && request.resource.data.statusLabel == '等待繪師確認'
        && request.resource.data.scheduleWeekLabel == '繪師確認後提供'
        && request.resource.data.dueDateLabel == null
        && request.resource.data.nextStep == '繪師正在閱讀委託內容，稍後會與您確認細節。'
        && request.resource.data.revokedAt == null
      );
      allow update, delete: if isArtist();
    }
  }
}
